# Only the separate media gateway receives cloud credentials.
# Fill on the server or inject via its secret store; never commit .env.gateway.
STORAGE_GATEWAY_API_KEY=
STORAGE_ATTESTATION_SECRET=
GATEWAY_DATABASE_URL=sqlite:///./data/gateway.db
GATEWAY_MAX_UPLOAD_BYTES=104857600
OSS_BUCKET=
OSS_REGION=
# True only when gateway and OSS run in the same Alibaba region.
OSS_USE_INTERNAL_ENDPOINT=false
# Preferred on the authorized ECS: role credentials rotate through IMDSv2.
OSS_CREDENTIAL_MODE=ecs_ram_role
ECS_RAM_ROLE_NAME=VideoAIStudioStorageRole
# Only fill these for explicit OSS_CREDENTIAL_MODE=environment.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SESSION_TOKEN=
# Enable only after the cloud account, subscription, scoped role and budget are ready.
GATEWAY_ICE_RENDER_ENABLED=false
GATEWAY_ICE_RENDER_MAX_OPERATIONS=6
GATEWAY_ICE_RENDER_MAX_DURATION_SECONDS=30
# Requires separately approved FC service, scoped function invocation, and ASR actions.
GATEWAY_ANALYSIS_ENABLED=false
GATEWAY_ANALYSIS_FC_ACCOUNT_ID=
GATEWAY_ANALYSIS_FC_FUNCTION_NAME=video-ai-shot-analysis
GATEWAY_ANALYSIS_MAX_OPERATIONS=6
GATEWAY_ANALYSIS_MAX_DURATION_SECONDS=30
GATEWAY_ANALYSIS_MAX_THUMBNAILS=30
# Bounded ZIP of approved existing archives; no rendering. Persistent quota counts IDs.
GATEWAY_PACKAGE_ENABLED=false
GATEWAY_PACKAGE_MAX_OPERATIONS=6
GATEWAY_PACKAGE_MAX_BYTES=104857600
# Disposable scratch files inside the gateway data volume; never the control plane.
GATEWAY_PACKAGE_TEMP_ROOT=./data/package-work
