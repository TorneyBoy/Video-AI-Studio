# SQLite is the default for local development. Compose overrides this with
# the Postgres URL shown below.
DATABASE_URL=sqlite:///./data/dev.db
APP_NAME=Video AI Studio
API_PREFIX=/api/v1
STORAGE_ROOT=./data/storage
MAX_UPLOAD_BYTES=5368709120
# Production asset ingestion records remote object URIs and returns a
# provider-supplied presigned URL; local is only for development fixtures,
# hybrid exposes both contracts during migration.
ASSET_STORAGE_MODE=external
ASSET_UPLOAD_SESSION_TTL_SECONDS=3600
# Metadata-only HTTPS gateway. Media bytes go directly to the storage host.
STORAGE_GATEWAY_URL=
STORAGE_GATEWAY_API_KEY=
STORAGE_GATEWAY_TIMEOUT_SECONDS=30
STORAGE_UPLOAD_HOSTS=
STORAGE_PUBLIC_HOSTS=
# Enable after the separate gateway's real ZIP IO and remaining storage budget are accepted.
DELIVERY_PACKAGE_ENABLED=false
DELIVERY_PACKAGE_MAX_BYTES=104857600
# Optional HMAC shared only with the external storage gateway. Once set,
# remote-upload-complete requires an asset-bound, expiring attestation.
# STORAGE_ATTESTATION_SECRET=replace-with-a-long-random-secret
RENDER_TIMEOUT_SECONDS=7200
WORKFLOW_WORKER_ID=local-worker
WORKFLOW_LEASE_SECONDS=7200
DEBUG=false

# Request-to-tenant authentication boundary. Development keeps the existing
# X-Tenant-ID contract. Production must use a trusted edge proxy that strips
# client identity headers and injects a signed claim envelope.
AUTH_MODE=development_header
# AUTH_MODE=trusted_proxy
# TRUSTED_PROXY_SHARED_SECRET=replace-with-a-long-random-secret
TRUSTED_PROXY_MAX_AGE_SECONDS=300

# AI/model execution policy. Production uses external HTTP model APIs only.
# Set PROVIDER_MODE=development_mock only for local contract tests; the mock
# emits auditable JSON manifests and never generates audio/video.
PROVIDER_MODE=api_only

# Optional real Provider registry. The JSON file is mounted into API/Worker;
# use a secret manager for HTTP authorization headers in production.
# PROVIDER_REGISTRY_PATH=./config/providers.json
# PROVIDER_REGISTRY_JSON={"providers":[]}
# Signed callbacks from commercial AI APIs. Leave unset until a provider
# callback URL is configured; never commit this secret.
# PROVIDER_WEBHOOK_SECRET=replace-with-a-long-random-secret
PROVIDER_WEBHOOK_MAX_AGE_SECONDS=300
# Production should set this to true so each signed event is bound to its
# target Job ID; false is retained only for staged migration of old providers.
PROVIDER_WEBHOOK_REQUIRE_REQUEST_ID=false

# Docker Compose (infra/docker-compose.yml) defaults. Change passwords before
# exposing a deployment outside a development machine.
POSTGRES_DB=video_ai_studio
POSTGRES_USER=video_ai
POSTGRES_PASSWORD=video_ai_dev
POSTGRES_PORT=5433
API_PORT=8000
WORKER_POLL_INTERVAL=2

# Optional MinIO profile: docker compose --profile object-storage up
MINIO_ROOT_USER=video_ai_dev
MINIO_ROOT_PASSWORD=video_ai_dev_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Production example (use a secret manager for credentials):
# DATABASE_URL=postgresql+psycopg://user:password@db.example:5432/creative
# Use production only with signed identity, PostgreSQL and verified storage.
APP_ENVIRONMENT=development
INTERNAL_API_SECRET=
# Independent read-only /metrics key. Unset in session/production denies scraping.
METRICS_API_SECRET=

# M2 public account boundary. Keep M1's private trusted-proxy deployment as-is
# until the complete M2 authentication/permission checks pass.
# AUTH_MODE=session
# AUTH_PUBLIC_ORIGIN=https://huayuan.ink
AUTH_REGISTRATION_ENABLED=false
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800

# Optional delivery sharing key (32+ random characters). Keep blank until deployment.
ARTIFACT_SHARE_SECRET=

# Shared by all local database-poller workers. Includes unresolved remote jobs.
# These are application admission ceilings, not an increase to provider quotas.
DISPATCH_GLOBAL_LIMIT=8
DISPATCH_TENANT_LIMIT=4
DISPATCH_PROJECT_LIMIT=3
DISPATCH_BATCH_LIMIT=2
# Internal diagnostics, independent worker pulse every 30s, no supplier probes.
OBSERVATION_QUEUE_WARNING_SECONDS=300
OBSERVATION_REMOTE_WARNING_SECONDS=900
OBSERVATION_BILLING_WARNING_SECONDS=3600
OBSERVATION_WORKER_STALE_SECONDS=120
