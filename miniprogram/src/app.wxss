page{background:#111115;color:#f4f0fa;font-family:-apple-system,"PingFang SC",sans-serif;font-size:28rpx}.page{padding:40rpx 32rpx 64rpx}.eyebrow{color:#bba6f5;font-size:22rpx;letter-spacing:3rpx}.title{font-size:48rpx;font-weight:700;line-height:1.35;margin:16rpx 0}.intro,.muted{color:#a59cb2;line-height:1.7;font-size:25rpx}.card{background:#1d1a25;border:1rpx solid #393142;border-radius:24rpx;padding:28rpx;margin-top:24rpx}.card-title{font-size:32rpx;font-weight:600;margin-bottom:12rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.stack{display:flex;flex-direction:column;gap:16rpx}.primary,.secondary{border-radius:16rpx;font-size:28rpx;margin:24rpx 0 0}.primary{background:#8970ec;color:white}.secondary{background:#292331;color:#d4c6ef}button::after{border:0}button[disabled]{opacity:.5}.input{border:1rpx solid #4d425b;border-radius:16rpx;padding:22rpx;background:#141019;color:#fff;margin-top:16rpx;min-height:44rpx}.status{color:#d4c0ff;font-size:25rpx;line-height:1.7;margin:24rpx 0}.label{display:block;color:#cfc2de;margin:28rpx 0 8rpx}.small{font-size:22rpx;color:#a59cb2}.pill{color:#c7b2fa;background:#30263f;border-radius:8rpx;padding:6rpx 12rpx;font-size:22rpx}.divider{height:1rpx;background:#393142;margin:28rpx 0}
