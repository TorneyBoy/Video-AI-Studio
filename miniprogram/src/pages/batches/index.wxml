<view class="page"><view class="title">批量制作 · 剪辑计划</view><view class="intro">共用设置按需覆盖；每项保留独立计划。先核对数量与分析预占，再确认整批。</view>
 <view class="row"><button class="secondary" bindtap="newBatch" disabled="{{busy || pending}}">新建批次</button><button class="secondary" bindtap="load" disabled="{{busy}}">刷新状态</button></view><view class="card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openBatch"><view>{{item.name}} · {{item.label}}</view><view class="small">{{item.aggregate.succeeded}} / {{item.aggregate.total}} 计划完成</view></view><button class="secondary" wx:if="{{more}}" bindtap="more" disabled="{{busy}}">更多批次</button>
 <view class="status">{{status}}</view><view class="card" wx:if="{{pending}}"><view class="card-title">原批次操作尚待核对</view><view class="small">沿用原标识与正文；查询本身不创建任务。</view><button class="secondary" bindtap="recover" disabled="{{busy}}">核对原提交</button><button class="secondary" bindtap="recover" data-repeat="true" disabled="{{busy}}">继续原提交</button></view>
 <block wx:if="{{current.state === 'submitted'}}"><view class="card"><view class="card-title">{{current.name}}</view><button class="primary" bindtap="openRuns" disabled="{{busy}}">批次生成与所选任务恢复</button><view>{{aggregateLabel}} · {{current.aggregate.succeeded}} / {{current.aggregate.total}} 计划完成</view><view>待处理 {{current.aggregate.attention}} 项</view><view class="small">已提交配置固定保留；失败项可从原任务恢复，成功项可独立继续编辑。</view></view><view class="card" wx:for="{{outputs}}" wx:key="key"><view class="card-title">{{index + 1}}. {{item.name}}</view><view>{{item.status}}</view><view class="row" wx:if="{{item.job_id}}"><button class="secondary" data-id="{{item.job_id}}" bindtap="openPlan">打开计划</button><button class="secondary" data-id="{{item.job_id}}" bindtap="openJob">原任务与费用</button></view></view><button class="secondary" bindtap="newBatch" data-clone="true" disabled="{{busy || pending}}">复制配置为新批次</button></block>
 <block wx:else><view class="card"><view class="card-title">批次草稿</view><input class="input" value="{{cache.form.name}}" bindinput="nameInput" maxlength="200" disabled="{{busy || pending}}"/><view>服务器版本 {{cache.revision || '尚未保存'}} · {{dirty ? '本机草稿未保存' : '已保存'}}</view><view>明确生成 {{cache.form.items.length}} 项计划</view></view>
  <view class="card"><view class="card-title">共用设置</view><picker range="{{templateNames}}" value="{{templateIndex}}" bindchange="templateChange" disabled="{{busy || pending}}"><view class="picker">模板 · {{templateNames[templateIndex]}} ▾</view></picker><input class="input" type="digit" value="{{target}}" bindblur="targetInput" placeholder="目标秒数，空白沿用模板" disabled="{{busy || pending}}"/><picker range="{{ratios}}" value="{{ratioIndex}}" bindchange="ratioChange" disabled="{{busy || pending}}"><view class="picker">画幅 · {{ratios[ratioIndex]}} ▾</view></picker><view>共用 {{cache.form.shared.asset_ids.length}} 个素材</view><button class="secondary" bindtap="openAssets" disabled="{{busy || pending}}">去素材页挑选</button><button class="secondary" bindtap="assignAssets" data-shared="true" disabled="{{busy || pending}}">共用素材使用素材页所选</button><button class="secondary" bindtap="assignAssets" disabled="{{busy || pending}}">勾选项使用素材页所选</button><button class="secondary" bindtap="resetSelected" disabled="{{busy || pending}}">勾选项继承共用设置</button></view>
  <view class="row"><button class="secondary" bindtap="add" disabled="{{busy || pending}}">新增一项</button><button class="secondary" bindtap="copy" disabled="{{busy || pending}}">复制勾选项</button></view><view class="row"><button class="secondary" bindtap="fromAssets" disabled="{{busy || pending}}">所选素材各建一项</button><button class="secondary" bindtap="remove" disabled="{{busy || pending}}">移除勾选项</button></view>
  <view class="card" wx:for="{{rows}}" wx:key="key"><view class="row"><button class="small-button" bindtap="selectItem" data-key="{{item.key}}" disabled="{{busy || pending}}">{{item.selected ? '☑' : '☐'}} {{index + 1}}</button><input class="input" value="{{item.name}}" bindinput="itemName" data-key="{{item.key}}" maxlength="200" disabled="{{busy || pending}}"/></view><view class="small">{{item.count}} 素材 · {{item.difference}}</view><view class="error">{{item.problem}}</view><button class="secondary" size="mini" bindtap="editItem" data-key="{{item.key}}">{{editingKey === item.key ? '收起' : '单项设置'}}</button><block wx:if="{{editingKey === item.key}}"><picker range="{{itemTemplateNames}}" value="{{item.templateIndex}}" bindchange="templateChange" data-key="{{item.key}}" disabled="{{busy || pending}}"><view class="picker">模板 · {{itemTemplateNames[item.templateIndex]}} ▾</view></picker><input class="input" type="digit" value="{{item.durationText}}" bindblur="targetInput" data-key="{{item.key}}" placeholder="秒数，空白继承共用" disabled="{{busy || pending}}"/><button class="secondary" size="mini" bindtap="templateDuration" data-key="{{item.key}}" disabled="{{busy || pending}}">本项沿用模板时长</button><view class="small" wx:if="{{item.templateDuration}}">已覆盖为模板时长</view><picker range="{{itemRatios}}" value="{{item.ratioIndex}}" bindchange="ratioChange" data-key="{{item.key}}" disabled="{{busy || pending}}"><view class="picker">画幅 · {{itemRatios[item.ratioIndex]}} ▾</view></picker></block></view>
  <view class="card"><view class="card-title">粘贴任务清单</view><view class="small">每行一个名称。高级格式用Tab分隔：名称、素材ID逗号列表、模板ID、时长、画幅；空列继承共用。也可粘贴含name及覆盖字段的JSON数组。</view><textarea class="input" value="{{paste}}" bindinput="pasteInput" placeholder="商品A&#10;商品B" maxlength="20000" disabled="{{busy || pending}}"/><button class="secondary" bindtap="pasteItems" disabled="{{busy || pending}}">加入清单</button></view><view class="error" wx:for="{{issues}}" wx:key="index"><text wx:if="{{!item.key}}">{{item.message}}</text></view>
  <button class="secondary" bindtap="save" disabled="{{busy || pending}}">保存草稿</button><button class="secondary" wx:if="{{cache.id}}" bindtap="openBatch" data-replace="true" disabled="{{busy || pending}}">载入服务器当前配置（替换输入）</button><button class="primary" bindtap="getQuote" disabled="{{busy || pending}}">校验并获取整批报价</button>
 </block><view class="card" wx:if="{{quote}}"><view class="card-title">{{quote.item_count}} 项计划 · {{quote.unique_asset_count}} 个不同素材</view><view wx:for="{{quoteTotals}}" wx:key="*this">新增预占 {{item}}</view><view wx:if="{{!quoteTotals.length}}">无需新增分析预占</view><view class="small">有效期至 {{quote.expires_at}}</view><view class="small">{{quote.note}}</view><view class="card" wx:for="{{quoteItems}}" wx:key="key"><view>{{item.name}} · {{item.summary}}</view><view>本项分配 {{item.amount}}</view></view><view class="error" wx:for="{{quoteProblems}}" wx:key="*this">{{item}}</view><view class="error">{{quoteReasons}}</view><button class="primary" bindtap="confirm" disabled="{{busy || pending || dirty || !quote.can_submit}}">确认报价，生成 {{quote.item_count}} 项计划</button></view>
</view>
