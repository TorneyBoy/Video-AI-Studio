<view class="page"><view class="eyebrow">MATERIALS</view><view class="title">项目素材</view><view class="intro">上传与整理素材，接着创建剪辑计划。</view>
  <button class="primary" wx:if="{{!signedIn}}" bindtap="login">登录个人空间</button><button class="secondary" wx:elif="{{!projectSelected}}" bindtap="chooseProject">先选择项目</button>
  <block wx:if="{{signedIn &amp;&amp; projectSelected}}">
    <view class="card"><view class="card-title">添加素材</view><view class="row"><button class="primary" bindtap="chooseMedia" disabled="{{uploading}}">相册 / 拍摄</button><button class="secondary" bindtap="chooseFiles" disabled="{{uploading}}">聊天文件 / 音频</button></view><view class="row option"><text>上传后提示分析报价</text><switch checked="{{analyze}}" bindchange="analyzeChange" color="#8970ec"/></view><view class="small">离开小程序后上传可能中断；重新打开可核验结果或重选原文件。</view></view>
    <view class="card upload" wx:for="{{uploads}}" wx:key="id"><view class="card-title">{{item.name}}</view><view class="muted">{{item.label}}</view><progress wx:if="{{item.percent !== null}}" percent="{{item.percent}}" activeColor="#aa88f4" show-info/><view class="error">{{item.error}}</view><view class="row" wx:if="{{!item.busy &amp;&amp; !item.ready}}"><button wx:if="{{item.canVerify}}" class="secondary" size="mini" data-id="{{item.id}}" bindtap="verify">核验已有上传</button><button class="secondary" size="mini" data-id="{{item.id}}" bindtap="reselect" disabled="{{uploading}}">重选原文件</button></view></view>
    <view class="card"><input class="input" value="{{query}}" bindinput="queryInput" placeholder="搜索名称" maxlength="200" confirm-type="search" bindconfirm="search"/><input class="input" value="{{tag}}" bindinput="tagInput" placeholder="按标签筛选" maxlength="64"/><view class="row"><picker range="{{kindNames}}" value="{{kindIndex}}" bindchange="kindChange"><view class="picker">{{kindNames[kindIndex]}} ▾</view></picker><button class="secondary" size="mini" bindtap="search" disabled="{{loading}}">筛选</button></view></view>
    <view class="row selection"><text>已选 {{selectedCount}} 个</text><button class="secondary" size="mini" bindtap="analysisQuote">分析报价 / 核对原提交</button><button class="secondary" size="mini" bindtap="openLabels">整理所选</button></view>
    <view class="card asset {{item.selected ? 'selected' : ''}}" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleSelection"><view class="row"><view class="card-title">{{item.selected ? '☑' : '☐'}} {{item.name}}</view><text class="pill">{{item.status}}</text></view><view class="muted">{{item.kind}} {{item.tags ? '· ' + item.tags : ''}}</view></view>
    <button class="secondary" wx:if="{{more}}" bindtap="loadMore" disabled="{{loading}}">加载更多</button>
    <view class="muted" wx:if="{{!loading &amp;&amp; !items.length}}">{{query || tag || kindIndex ? '没有匹配的素材，可调整筛选条件。' : '这个项目还没有素材。'}}</view>
    <view class="card" wx:if="{{editing}}"><view class="card-title">{{editSingle ? '整理素材' : '批量追加标签'}}</view><block wx:if="{{editSingle}}"><text class="label">素材名称</text><input class="input" value="{{editName}}" bindinput="nameInput" maxlength="200"/></block><text class="label">{{editSingle ? '标签（逗号分隔）' : '追加标签，保留每个素材的原标签'}}</text><input class="input" value="{{editTags}}" bindinput="tagsInput" maxlength="1000"/><block wx:if="{{editSingle}}"><text class="label">备注</text><textarea class="input note" value="{{editNote}}" bindinput="noteInput" maxlength="2000"/></block><view class="status">{{editStatus}}</view><view class="row"><button class="primary" bindtap="saveLabels" disabled="{{saving || editFinished}}">保存</button><button class="secondary" bindtap="closeLabels" disabled="{{saving}}">关闭</button></view></view>
    <button class="secondary" bindtap="openBatch">将所选素材用于批量制作</button><button class="primary" bindtap="continueCreate">继续创作 · {{selectedCount}} 个素材</button>
  </block><view class="status" role="status">{{status}}</view>
</view>
