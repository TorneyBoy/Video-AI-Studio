<view class="page">
  <view class="title">费用与任务恢复</view>
  <view class="intro">已提交任务离开页面后继续运行。恢复沿用原任务；取消不等于退款，迟到费用仍须对账。</view>
  <view class="card" wx:if="{{pendingAnalysis}}"><view class="card-title">分析确认尚待核对</view><button class="secondary" bindtap="recoverAnalysis" disabled="{{busy}}">核对原提交</button><button class="secondary" bindtap="recoverAnalysis" data-repeat="true" disabled="{{busy}}">继续原提交</button></view>
  <view class="card" wx:if="{{prepMode}}"><view class="card-title">{{prepMode === 'plan' ? '分析与剪辑计划综合报价' : '素材分析报价'}}</view><view class="small">报价只读元数据，确认后新增分析才预占；原任务优先复用。</view>
    <block wx:if="{{prepMode === 'analysis'}}"><view>镜头分析 <switch checked="{{shotAnalysis}}" bindchange="prepSetting" data-field="shotAnalysis" disabled="{{busy || pendingAnalysis}}"/></view><view>语音转写 <switch checked="{{transcribe}}" bindchange="prepSetting" data-field="transcribe" disabled="{{busy || pendingAnalysis}}"/></view><view>明确重新分析（新的费用操作）<switch checked="{{forceNew}}" bindchange="prepSetting" data-field="forceNew" disabled="{{busy || pendingAnalysis}}"/></view></block>
    <view class="status">{{prepStatus}}</view><block wx:if="{{prepQuote}}"><view wx:for="{{prepTotals}}" wx:key="*this">新增预占 {{item}}</view><view wx:if="{{!prepTotals.length}}">本次无需新增分析预占</view><view class="card" wx:for="{{prepItems}}" wx:key="asset_id"><view>{{item.name}} · {{item.label}} {{item.amount}}</view><view class="small" wx:if="{{item.job_id}}">原任务 {{item.job_id}}</view><view class="error" wx:if="{{item.problem}}">{{item.problem}}</view></view><view class="small">有效期至 {{prepQuote.expires_at}}</view><view class="small">{{prepQuote.note}}</view><button class="primary" bindtap="confirmPreparation" disabled="{{busy || loading || !prepQuote.can_submit || pendingAnalysis || pendingRender}}">{{prepConfirmLabel}}</button></block><button class="secondary" bindtap="getPreparation" disabled="{{busy || loading || pendingAnalysis}}">重新获取报价</button></view>
  <view class="card" wx:if="{{pending}}"><view class="card-title">原取消/恢复操作尚待核对</view><button class="secondary" bindtap="recoverTask" disabled="{{busy}}">核对原操作</button><button class="secondary" bindtap="recoverTask" data-repeat="true" disabled="{{busy}}">继续原提交</button><button class="secondary" bindtap="forget" disabled="{{busy}}">清除本地记录并刷新</button><view class="small">清除本地记录不会取消服务器任务。</view></view>
  <view class="card" wx:if="{{pendingRender}}"><view class="card-title">制作页有待核对的提交</view><view>{{pendingRender.label}}</view><button class="secondary" bindtap="recoverRender" disabled="{{busy}}">核对原生成提交</button><button class="secondary" bindtap="recoverRender" data-repeat="true" disabled="{{busy}}">继续原生成提交</button></view>
  <view class="card" wx:if="{{quoteMode}}"><view class="card-title">确认本次生成报价</view><block wx:if="{{quote}}"><view>{{quote.summary.revision_number ? 'v' + quote.summary.revision_number : '原计划'}} · {{quote.summary.duration}}秒 · {{quote.summary.width}}×{{quote.summary.height}}</view><view class="card-title">预占上限 {{quoteAmount}}</view><view class="small">价格版本 {{quote.price_version}} · {{quote.provider}} / {{quote.model_id}} / {{quote.model_version}}</view><view class="small">{{quote.duration_bound_seconds === null ? '按次计费' : '最长计费时长 ' + quote.duration_bound_seconds + '秒'}} · 截止 {{quote.expires_at}}</view><button class="primary" bindtap="confirmQuote" disabled="{{busy || loading || pending || pendingRender || !quote.can_submit}}">确认报价并生成</button></block><view class="status">{{quoteStatus}}</view><button class="secondary" bindtap="getQuote" disabled="{{busy || loading}}">重新获取报价</button><button class="secondary" bindtap="back">返回制作页</button></view>
  <view class="actions"><picker range="{{scopes}}" value="{{scopeIndex}}" bindchange="scopeChange" disabled="{{loading || busy}}"><view class="input">费用范围：{{scopes[scopeIndex]}}</view></picker><picker range="{{filters}}" value="{{filterIndex}}" bindchange="filterChange" disabled="{{loading || busy}}"><view class="input">{{filters[filterIndex]}}</view></picker></view>
  <button class="secondary" bindtap="load" disabled="{{loading || busy}}">刷新费用与任务</button>
  <block wx:if="{{summary}}"><view class="intro">{{summary.note}}</view><view class="small">{{summary.scope === 'project_lifetime' ? '项目累计' : '空间本月 ' + summary.period_key}}</view><view class="card" wx:for="{{totals}}" wx:key="currency"><view class="card-title">{{item.currency}}</view><view>已记录结算 {{item.settled}} · 调整 {{item.adjustment}}</view><view>预占 {{item.reserved}}</view><view>待对账保留 {{item.pending}}（{{item.count}}项）</view><view>已释放 {{item.released}}</view></view><view class="muted" wx:if="{{!totals.length}}">当前范围尚无费用记录，不代表外部服务免费。</view>
    <view class="card"><view class="card-title">空间额度（{{summary.tenant_policy.currency}}）</view><view>本月上限 {{tenantMonthly}}</view><view>单任务上限 {{tenantTask}}</view><view>可用 {{tenantAvailable}}</view></view>
    <view class="card" wx:if="{{summary.project_policy}}"><view class="card-title">项目累计上限（{{summary.project_policy.currency}}）</view><view>当前上限 {{projectCurrent}} · 可用 {{projectRemaining}}</view><view class="small">{{summary.project_policy.note}}</view><block wx:if="{{summary.project_policy.can_manage}}"><input class="input" value="{{limitCurrency}}" bindinput="currencyInput" maxlength="3" placeholder="币种，如CNY或USD" disabled="{{busy || loading || pending}}"/><input class="input" value="{{limitText}}" bindinput="limitInput" placeholder="金额留空不加项目上限" disabled="{{busy || loading || pending}}"/><button class="secondary" bindtap="saveLimit" disabled="{{busy || loading || pending}}">保存项目上限</button><button class="secondary" bindtap="resetLimit" disabled="{{busy || loading}}">载入当前上限（替换输入）</button></block></view>
    <view class="card-title">费用记录（当前范围全部历史）</view><view class="card" wx:for="{{entries}}" wx:key="id"><view>{{item.status_label}} · {{item.currency}} {{item.amount}}</view><view class="small">{{item.name}} · {{item.label}} · {{item.period_key}}</view><view class="small">任务 {{item.shortId}}</view><view wx:if="{{item.is_estimate}}">预占/待对账金额，不是已付账单；未知费用仍需核对。</view><view>调整 {{item.adjustment}}</view><view wx:if="{{item.net_settled_micros !== null}}">结算净额 {{item.net}}</view></view><view wx:if="{{!entries.length}}" class="muted">暂无费用记录</view><button wx:if="{{moreEntries}}" class="secondary" bindtap="more" data-kind="entries" disabled="{{busy || loading}}">加载更多费用</button>
    <view class="card-title">任务恢复</view><view class="card" wx:for="{{jobs}}" wx:key="id"><view class="card-title">{{item.name}} · {{item.label}}</view><view class="small">任务 {{item.shortId}}</view><view>执行次数 {{item.attempt_count}}/{{item.max_attempts}}</view><view class="small">{{item.failure_message}}</view><view class="actions"><button class="small-button" bindtap="load" disabled="{{busy || loading}}">查询状态</button><button class="small-button" wx:if="{{item.can_retry}}" bindtap="action" data-id="{{item.id}}" data-action="retry" disabled="{{busy || loading || pending}}">恢复原任务</button><button class="small-button" wx:if="{{item.can_cancel}}" bindtap="action" data-id="{{item.id}}" data-action="cancel" disabled="{{busy || loading || pending}}">取消任务</button></view></view><view wx:if="{{!jobs.length}}" class="muted">当前筛选没有任务</view><button wx:if="{{moreJobs}}" class="secondary" bindtap="more" data-kind="jobs" disabled="{{busy || loading}}">加载更多任务</button>
  </block><view class="status">{{status}}</view>
</view>
