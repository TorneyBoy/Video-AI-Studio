<view class="page">
  <view class="eyebrow">SHOT SOURCES</view><view class="title">镜头素材与补拍</view><view class="intro">{{story.content.title}} · 分镜 v{{story.number}}。候选排序不等于采用；本页保存不生成或渲染媒体。</view><view class="status">{{status}}</view>
  <view class="card" wx:if="{{pending}}"><view>原操作待确认，输入已冻结。</view><button bindtap="recover" disabled="{{busy}}">查询原操作</button><button data-resend="true" bindtap="recover" disabled="{{busy}}">查询后重发原请求</button></view>
  <view class="card"><view class="card-title">1. 选择项目素材</view><view class="muted">内容标注由你核对填写，不是模型识别；没有语义依据的候选仍须人工核对。</view><view class="asset-row" wx:for="{{assetViews}}" wx:key="id"><button data-id="{{item.id}}" bindtap="toggleAsset" disabled="{{busy || pending}}">{{item.selected ? '✓ 已选' : '○ 选择'}} {{item.name}}</button><view class="row"><button data-id="{{item.id}}" bindtap="annotate" disabled="{{busy || pending}}">标注主体 / 动作</button><button data-id="{{item.id}}" bindtap="playback" disabled="{{busy || pending}}">查看素材</button></view></view><view class="muted">已选 {{cache.assetIds.length}} 个素材</view><button bindtap="clearAssets" disabled="{{busy || pending}}">清空素材选择</button><button data-kind="assets" bindtap="more" disabled="{{busy || pending}}">更多素材</button></view>
  <view class="card"><view class="card-title">逐镜头筛选条件（可选）</view><view wx:for="{{requirements}}" wx:key="id" class="asset-row"><view class="label">镜头 {{item.position}} · {{item.subject}}</view><picker range="{{mediaOptions}}" value="{{item.kindIndex}}" data-id="{{item.id}}" data-field="media_types" bindchange="overridePicker" disabled="{{busy || pending}}"><view class="input">{{mediaOptions[item.kindIndex]}}</view></picker><picker range="{{orientationOptions}}" value="{{item.orientationIndex}}" data-id="{{item.id}}" data-field="orientation" bindchange="overridePicker" disabled="{{busy || pending}}"><view class="input">源画幅：{{orientationOptions[item.orientationIndex]}}</view></picker><input class="input" value="{{item.required}}" data-id="{{item.id}}" data-field="required_tags" bindblur="overrideInput" placeholder="要求标签（顿号分隔）" disabled="{{busy || pending}}" /><input class="input" value="{{item.excluded}}" data-id="{{item.id}}" data-field="excluded_tags" bindblur="overrideInput" placeholder="排除标签（顿号分隔）" disabled="{{busy || pending}}" /></view><button class="primary" bindtap="build" disabled="{{busy || pending}}">建立候选报告（不调用 AI）</button></view>
  <view class="card" wx:if="{{annotationDraft}}"><view class="card-title">内容标注：{{annotationAsset.name}}</view><view class="muted">修改后旧报告会过期。整条素材标注不填时间；局部区间同时填写起止秒数。</view><view wx:for="{{annotationDraft.spans}}" wx:for-item="span" wx:key="id" class="asset-row"><view class="row"><input class="input" value="{{span.start}}" data-id="{{span.id}}" data-field="start" bindinput="annotationInput" placeholder="起点秒 / 整条留空" disabled="{{busy || pending}}" /><input class="input" value="{{span.end}}" data-id="{{span.id}}" data-field="end" bindinput="annotationInput" placeholder="终点秒 / 整条留空" disabled="{{busy || pending}}" /></view><view wx:for="{{fields}}" wx:for-item="field" wx:key="key"><view class="label">{{field.label}}</view><textarea class="input" value="{{span.visual[field.key]}}" data-id="{{span.id}}" data-field="{{'visual.' + field.key}}" bindinput="annotationInput" maxlength="1000" disabled="{{busy || pending}}" /></view><input class="input" value="{{span.tagsText}}" data-id="{{span.id}}" data-field="tagsText" bindinput="annotationInput" placeholder="标签，顿号分隔" disabled="{{busy || pending}}" /><button data-id="{{span.id}}" bindtap="deleteAnnotation" disabled="{{busy || pending || annotationDraft.spans.length === 1}}">移除此标注</button></view><button bindtap="addAnnotation" disabled="{{busy || pending}}">添加其他区间标注</button><textarea class="input" value="{{annotationDraft.note}}" bindinput="annotationNote" maxlength="2000" placeholder="标注说明" disabled="{{busy || pending}}" /><button bindtap="annotationConfirm" disabled="{{busy || pending}}">{{annotationDraft.confirmed ? '✓ 已核对并确认上述标注' : '○ 确认标注来自我对素材的核对'}}</button><button class="primary" bindtap="saveAnnotation" disabled="{{busy || pending}}">保存内容标注新版本</button></view>
  <view class="card" wx:if="{{playerUrl}}"><image wx:if="{{playerKind === 'image'}}" src="{{playerUrl}}" mode="widthFix" /><video wx:else id="matchingPlayer" src="{{playerUrl}}" initial-time="{{playerStart}}" controls /></view>
  <view class="card" wx:if="{{cache.report}}"><view class="card-title">2. 逐镜头决定</view><view class="status" wx:if="{{changed}}">需求、素材配置或证据已变化，请重新匹配；旧候选只供查看。</view><view wx:if="{{cache.source.revision_id}}">素材记录 v{{cache.source.number}} {{cache.source.story_current ? '' : '· 来自旧分镜'}} {{cache.source.inputs_current ? '' : '· 采用输入已变化'}}</view><button bindtap="openReport" disabled="{{busy || pending}}">载入本报告与当前来源</button><view class="muted" wx:for="{{cache.report.result.excluded_assets}}" wx:key="asset_id">排除素材：{{item.name}}（{{item.reason === 'reference_only' ? '仅供参考' : item.reason === 'upload_incomplete' ? '上传尚未核验' : '缺少可用媒体区间'}}）</view></view>
  <view class="card" wx:for="{{items}}" wx:for-item="shot" wx:key="shot_id"><view class="card-title">镜头 {{shot.position}} · {{shot.seconds}} 秒</view><view>{{shot.reshoot.intent}}</view><view>当前决定：{{shot.decisionText}}</view><view class="muted">原报告：{{shot.gapText}}</view><view wx:if="{{shot.old.binding}}">原素材：{{shot.old.binding.name}} {{shot.old.locked ? '（锁定）' : ''}} {{shot.old.requirement_hash === shot.requirement_hash ? '' : '· 需求已变化，须明确解锁并重选'}}</view><view class="candidate" wx:for="{{shot.candidates}}" wx:for-item="candidate" wx:key="id"><view class="label">{{candidate.name}} · {{candidate.rangeText}}</view><view class="muted">{{candidate.reasonsText}}</view><view class="muted">{{candidate.semantic_provenance === 'user_confirmed' ? '依据：用户确认的内容标注' : '语义依据尚未提供'}}</view><view class="muted" wx:if="{{candidate.observedText}}">用户标注：{{candidate.observedText}}</view><view class="review" wx:if="{{candidate.reviewText}}">须核对：{{candidate.reviewText}}</view><view class="muted" wx:if="{{candidate.diversity.already_recommended_source}}">同源素材已被其他镜头推荐，可比较其他候选减少重复。</view><button class="primary" data-id="{{candidate.id}}" data-shot="{{shot.shot_id}}" bindtap="candidate" disabled="{{busy || pending || changed || shot.choice.locked}}">{{shot.choice.candidate_id === candidate.id ? '已选此候选' : '采用此候选'}}</button><button data-id="{{candidate.asset_id}}" data-kind="{{candidate.kind}}" data-start="{{candidate.start_ms}}" bindtap="playback" disabled="{{busy || pending}}">查看区间起点</button></view><view class="muted">{{shot.excludedText}}</view><view class="row"><button data-id="{{shot.shot_id}}" data-mode="unassigned" bindtap="sourceMode" disabled="{{busy || pending || shot.choice.locked}}">{{shot.choice.mode === 'unassigned' ? '✓ ' : ''}}暂留缺口</button><button data-id="{{shot.shot_id}}" data-mode="reshoot" bindtap="sourceMode" disabled="{{busy || pending || shot.choice.locked}}">{{shot.choice.mode === 'reshoot' ? '✓ ' : ''}}安排补拍</button><button wx:if="{{shot.old.binding}}" data-id="{{shot.shot_id}}" data-mode="keep" bindtap="sourceMode" disabled="{{busy || pending || shot.choice.locked}}">{{shot.choice.mode === 'keep' ? '✓ ' : ''}}保留原素材</button></view><button data-id="{{shot.shot_id}}" bindtap="sourceLock" disabled="{{busy || pending || (shot.choice.mode !== 'candidate' &amp;&amp; shot.choice.mode !== 'keep')}}">{{shot.choice.locked ? '解锁所选素材' : '锁定所选素材'}}</button><button data-id="{{shot.shot_id}}" bindtap="sourceReview" disabled="{{busy || pending || shot.choice.locked || shot.choice.mode === 'keep'}}">{{shot.choice.reviewed ? '✓ 已核对' : '○ 我已核对'}}未验证条件和商品细节</button><textarea class="input" value="{{shot.choice.note}}" data-id="{{shot.shot_id}}" bindinput="sourceNote" maxlength="2000" placeholder="采用依据 / 补拍备注" disabled="{{busy || pending || shot.choice.locked}}" /><button class="secondary" data-id="{{shot.shot_id}}" bindtap="generateShot" disabled="{{busy || pending || shot.choice.locked}}">用 AI 补这个镜头</button><view class="label">镜头要求与补拍说明</view><view wx:for="{{fields}}" wx:for-item="field" wx:key="key"><view class="muted" wx:if="{{shot.reshoot.visual[field.key]}}">{{field.label}}：{{shot.reshoot.visual[field.key]}}</view></view><view class="muted" wx:for="{{shot.reshoot.constraints}}" wx:key="*this">必须保留：{{item}}</view><view class="muted" wx:for="{{shot.reshoot.facts}}" wx:key="*this">资料事实：{{item}}</view></view>
  <view class="card" wx:if="{{cache.report}}"><button wx:for="{{removedLocks}}" wx:key="id" data-id="{{item.id}}" bindtap="removedUnlock" disabled="{{busy || pending}}">{{item.unlocked ? '✓ ' : ''}}明确解锁已移除镜头 {{item.id}} 的旧素材</button><button bindtap="toggleReuse" disabled="{{busy || pending}}">{{cache.allowReuse ? '✓ 已允许' : '○ 允许'}}同一图片或重叠区间重复使用</button><button class="primary" bindtap="save" disabled="{{busy || pending || changed}}">保存素材决定新版本</button><button bindtap="reshoot" disabled="{{busy || pending || !cache.source.revision_id}}">查看已保存的补拍清单</button><view class="manifest" wx:if="{{manifestText}}">{{manifestText}}</view><button wx:if="{{manifestText}}" bindtap="copyReshoot">复制补拍清单</button><button data-kind="history" bindtap="more" disabled="{{busy || pending}}">载入来源版本记录</button><view wx:for="{{sourceHistory}}" wx:for-item="revision" wx:key="revision_id"><view class="label">素材记录 v{{revision.number}} {{revision.story_current ? '' : '（旧分镜）'}}</view><view class="muted" wx:for="{{revision.content.choices}}" wx:key="shot_id">{{item.shot_id}}：{{item.binding ? item.binding.name : item.mode === 'reshoot' ? '安排补拍' : '暂留缺口'}} {{item.locked ? '（锁定）' : ''}}</view></view></view>
  <view class="card"><view class="card-title">已有候选报告</view><button wx:for="{{reports}}" wx:key="id" data-id="{{item.id}}" bindtap="openReport" disabled="{{busy || pending}}">{{item.created_at}} · {{item.result.summary.with_candidates}}/{{item.result.summary.shots}} 镜头有候选 {{item.stale_inputs ? '（输入已变化）' : ''}}</button><button data-kind="reports" bindtap="more" disabled="{{busy || pending}}">更多报告</button></view>
</view>
