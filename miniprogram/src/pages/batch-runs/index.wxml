<view class="page"><view class="title">生成与批次恢复</view><view class="intro">每轮保留选定版本。已有同版任务优先复用；恢复原任务与新增生成分别处理。</view><view class="card" wx:if="{{batch}}"><view class="card-title">{{batch.name}}</view><button class="secondary" bindtap="refresh" disabled="{{busy}}">刷新状态</button><picker range="{{phaseNames}}" value="{{phaseIndex}}" bindchange="phaseChange" disabled="{{busy || pending}}"><view class="picker">{{phaseNames[phaseIndex]}} ▾</view></picker><button class="secondary" wx:if="{{more}}" bindtap="more" disabled="{{busy}}">更多生成记录</button><view>{{summary}}</view><view class="small">{{phaseNote}}</view></view>
 <view class="status">{{status}}</view><view class="card" wx:if="{{pending}}"><view class="card-title">原批次操作尚待核对</view><view class="small">沿用原标识与正文，不另建费用操作。</view><button class="secondary" bindtap="recover" disabled="{{busy}}">核对原提交</button><button class="secondary" bindtap="recover" data-repeat="true" disabled="{{busy}}">继续原提交</button></view>
 <view class="card" wx:if="{{otherPending}}"><view>有其他制作或任务操作尚待核对，请先处理原提交。</view><button class="secondary" bindtap="openPending" disabled="{{busy}}">前往原提交</button></view>
 <block wx:if="{{batch}}"><view class="card"><button class="secondary" wx:if="{{active === 'plan'}}" bindtap="choose" data-mode="ready" disabled="{{busy || pending}}">选择可生成项</button><view class="row"><button class="secondary" bindtap="choose" data-mode="all" disabled="{{busy || pending}}">选择当前全部</button><button class="secondary" bindtap="choose" data-mode="none" disabled="{{busy || pending}}">清空选择</button></view><view class="row"><button class="secondary" bindtap="taskAction" data-action="retry" disabled="{{busy || pending || otherPending || !retryCount}}">恢复可重试项（{{retryCount}}）</button><button class="secondary" bindtap="taskAction" data-action="cancel" disabled="{{busy || pending || otherPending || !cancelCount}}">取消可取消项（{{cancelCount}}）</button></view><view class="small">取消只停止所选本地任务，不表示退款。复用任务的其他引用也受影响，共用分析及已提交远端可能继续运行和计费。</view></view>
  <view class="card" wx:for="{{rows}}" wx:key="key"><view class="row"><button class="small-button" data-key="{{item.key}}" bindtap="select" disabled="{{busy || pending}}">{{item.selected ? '☑' : '☐'}}</button><view class="card-title">{{item.name}}</view></view><view>{{item.version}} · {{item.label}} {{item.disposition === 'reused' ? '· 复用原任务' : ''}}</view><view class="small">{{item.task.failure_message}}</view><view class="row"><button class="secondary" wx:if="{{active === 'plan'}}" bindtap="openEditor" data-key="{{item.key}}" disabled="{{busy || !item.job_id}}">打开编辑</button><button class="secondary" wx:else bindtap="openWork" data-key="{{item.key}}" disabled="{{busy || !item.artifact_id || item.status !== 'succeeded'}}">查看成片 / 审核</button><button class="secondary" bindtap="openJob" data-key="{{item.key}}" disabled="{{busy || !item.job_id}}">原任务与费用</button></view></view>
  <view class="card" wx:if="{{active === 'plan'}}"><picker range="{{qualities}}" value="{{qualityIndex}}" bindchange="qualityChange" disabled="{{busy || pending}}"><view class="picker">生成规格 · {{qualities[qualityIndex]}} ▾</view></picker><view>明确新增生成 · 新的费用操作<switch checked="{{forceNew}}" bindchange="newChange" disabled="{{busy || pending}}"/></view><button class="primary" bindtap="getQuote" disabled="{{busy || pending || otherPending || !selected.length}}">获取所选 {{selected.length}} 项渲染报价</button></view><button class="primary" wx:if="{{active !== 'plan'}}" bindtap="openDelivery" disabled="{{busy || pending || otherPending}}">审核与领取本轮成片</button><button class="secondary" wx:if="{{active !== 'plan'}}" bindtap="plan" disabled="{{busy || pending}}">返回当前计划选择版本</button>
  <view class="card" wx:if="{{quote}}"><view class="card-title">{{quote.item_count}} 项固定版本渲染报价</view><view wx:for="{{quoteTotals}}" wx:key="*this">新增预占 {{item}}</view><view wx:if="{{!quoteTotals.length}}">本次无新增生成预占</view><view class="small">有效期至 {{quote.expires_at}}</view><view class="small">{{quote.note}}</view><view class="card" wx:for="{{quoteItems}}" wx:key="key"><view>{{item.name}} · {{item.version}} · {{item.amount}}</view><view class="error" wx:if="{{item.problem}}">{{item.problem}}</view></view><view class="error">{{quoteReasons}}</view><button class="primary" bindtap="confirm" disabled="{{busy || pending || otherPending || !quote.can_submit}}">确认所列版本与报价</button></view>
 </block></view>
