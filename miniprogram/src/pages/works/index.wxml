<view class="page"><view class="eyebrow">WORKS</view><view class="title">项目作品</view><view class="intro">查看任务、比较版本、审阅并领取成片。</view><button class="primary" wx:if="{{!signedIn}}" bindtap="login">登录个人空间</button><button class="secondary" wx:elif="{{!projectSelected}}" bindtap="chooseProject">先选择项目</button><block wx:if="{{signedIn &amp;&amp; projectSelected}}"><picker range="{{filters}}" value="{{filter}}" bindchange="filterChange" disabled="{{loading}}"><view class="input">筛选：{{filters[filter]}}</view></picker><button class="secondary" bindtap="refreshWorks" disabled="{{loading}}">刷新状态</button><view class="muted">全部渲染任务 {{total}} 项，当前显示 {{items.length}} 项</view><view class="card" wx:for="{{items}}" wx:key="job_id" data-id="{{item.job_id}}" bindtap="openWork"><view class="row"><view class="card-title">{{item.label}}</view><text class="pill">{{item.status_label}}</text></view><view>{{item.spec}}</view><view class="small">{{item.reason}}</view><view class="small">{{item.artifact_id ? '打开审阅与交付 →' : '点击查看状态说明'}}</view></view><view class="muted" wx:if="{{!items.length &amp;&amp; !loading}}">当前页没有匹配项。</view><button class="secondary" wx:if="{{more}}" bindtap="moreWorks" disabled="{{loading}}">加载更多</button></block><view class="status">{{status}}</view></view>
