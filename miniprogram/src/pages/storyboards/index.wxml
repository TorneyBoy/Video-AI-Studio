<view class="page">
  <view class="eyebrow">STORYBOARD</view><view class="title">参考创作与分镜</view><view class="intro">参考结构、资料事实、画面意图和旁白分开确认。保存分镜不创建 AI 执行任务。</view>
  <view class="status">{{status}}</view><view class="card" wx:if="{{pending}}"><view>有一次操作尚待确认，输入已冻结。</view><button bindtap="recover" disabled="{{busy}}">查询原操作</button><button bindtap="recover" data-resend="true" disabled="{{busy}}">查询后重发原请求</button></view>
  <view class="card"><view class="card-title">1. 选择参考范围</view><picker range="{{assets}}" range-key="name" value="{{assetIndex}}" bindchange="chooseAsset" disabled="{{busy || pending}}"><view class="input">{{assets[assetIndex].name || '先在素材页上传视频'}}</view></picker><button bindtap="more" data-kind="assets" disabled="{{busy || pending}}">载入更多素材</button><view class="label">起点（秒）</view><input class="input" value="{{start}}" data-field="start" bindinput="input" disabled="{{busy || pending}}" /><view class="label">终点（秒）</view><input class="input" value="{{end}}" data-field="end" bindinput="input" disabled="{{busy || pending}}" /><view class="label">来源和授权备注</view><textarea class="input" value="{{note}}" data-field="note" bindinput="input" maxlength="2000" disabled="{{busy || pending}}" /><button bindtap="saveReference" disabled="{{busy || pending || cache.draft}}">保存范围与已有分析</button><view class="muted">没有托管分析时可以手工策划；分享链接只作备注，不自动取回。</view><button wx:for="{{references}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseReference" disabled="{{busy || pending}}">{{item.asset_name}} · {{item.evidence.range.start_ms}}–{{item.evidence.range.end_ms}} ms</button><button bindtap="more" data-kind="references" disabled="{{busy || pending}}">更多参考</button></view>
  <view class="card" wx:if="{{reference}}"><view class="card-title">{{reference.asset_name}}</view><view class="status" wx:if="{{!reference.source_current}}">源对象已变化，请重新登记。</view><view wx:for="{{reference.evidence.warnings}}" wx:key="*this" class="muted">{{item}}</view><button bindtap="playback" disabled="{{busy || pending}}">播放 / 更新播放链接</button><video wx:if="{{playerUrl}}" id="referencePlayer" src="{{playerUrl}}" initial-time="{{playerStart}}" controls bindtimeupdate="timeUpdate" /><button bindtap="toggleOutput" disabled="{{busy || pending}}">{{reference.allow_output ? '已允许进入成片，改为仅供参考' : '仅供分析；如有使用权可允许进入成片'}}</button><view class="span" wx:for="{{reference.evidence.spans}}" wx:key="id"><button data-start="{{item.start_ms}}" bindtap="playback" disabled="{{busy || pending}}">{{item.start_ms}}–{{item.end_ms}} ms · {{item.evidence === 'hosted_cut' ? '托管切点' : '待确认区间'}}</button><view class="muted" wx:if="{{item.confidence !== null}}">置信度 {{item.confidence}}</view><view class="transcript">{{item.transcript}}</view></view><view class="muted">来源：{{reference.evidence.provenance.provider || '手工范围'}} {{reference.evidence.provenance.version}}</view><button class="primary" data-reference="true" bindtap="newStory" disabled="{{busy || pending}}">按参考区间建立分镜草稿</button></view>
  <view class="card"><view class="card-title">2. 分镜方案</view><button bindtap="newStory" disabled="{{busy || pending}}">新建手工分镜</button><button wx:for="{{stories}}" wx:key="document_id" data-id="{{item.document_id}}" bindtap="openStory" disabled="{{busy || pending}}">{{item.content.title}} · v{{item.number}} · {{item.content.status === 'confirmed' ? '已确认' : '草稿'}}</button><button bindtap="more" data-kind="storyboards" disabled="{{busy || pending}}">更多分镜</button></view>
  <block wx:if="{{content}}"><view class="card"><view class="card-title">{{view ? '历史只读版本 v' + view.number : cache.base ? '当前版本 v' + cache.base.number : '未保存草稿'}}</view><view class="muted">合计 {{totalSeconds}} 秒 · {{content.shots.length}} 镜头</view><view class="label">分镜名称</view><input class="input" value="{{content.title}}" bindinput="titleInput" maxlength="200" disabled="{{busy || pending || view}}" /><view class="label">当前商品 / 品牌事实</view><view class="muted">填写自己的资料；参考字幕不会自动成为事实或配音。</view><view wx:for="{{content.facts}}" wx:key="id" class="fact"><textarea class="input" value="{{item.text}}" data-id="{{item.id}}" bindinput="factInput" maxlength="2000" disabled="{{busy || pending || view || item.locked}}" /><view class="row"><button data-id="{{item.id}}" data-action="confirm" bindtap="factAction" disabled="{{busy || pending || view || item.locked}}">{{item.confirmed ? '已核对' : '待核对'}}</button><button data-id="{{item.id}}" data-action="lock" bindtap="factAction" disabled="{{busy || pending || view}}">{{item.locked ? '解锁' : '锁定'}}</button><button data-id="{{item.id}}" data-action="delete" bindtap="factAction" disabled="{{busy || pending || view || item.locked}}">删除</button></view></view><button bindtap="addFact" disabled="{{busy || pending || view}}">添加事实</button></view>
    <view class="card" wx:for="{{shotViews}}" wx:for-item="shot" wx:for-index="position" wx:key="id"><view class="row"><view class="card-title">镜头 {{position + 1}}</view><button data-id="{{shot.id}}" bindtap="lockShot" disabled="{{busy || pending || view}}">{{shot.locked ? '解锁内容' : '锁定内容'}}</button></view><view class="label">时长（秒）</view><input class="input" value="{{shot.seconds}}" data-id="{{shot.id}}" data-field="duration_ms" bindblur="shotInput" disabled="{{busy || pending || view || shot.locked}}" /><view class="label">内容意图</view><textarea class="input" value="{{shot.intent}}" data-id="{{shot.id}}" data-field="intent" bindinput="shotInput" maxlength="2000" disabled="{{busy || pending || view || shot.locked}}" /><block wx:for="{{fields}}" wx:for-item="field" wx:key="key"><view wx:if="{{field.key === 'subject' || field.key === 'action' || field.key === 'scene' || advanced[shot.id]}}"><view class="label">{{field.label}}</view><textarea class="input" value="{{shot.visual[field.key]}}" data-id="{{shot.id}}" data-field="{{'visual.' + field.key}}" bindinput="shotInput" maxlength="1000" disabled="{{busy || pending || view || shot.locked}}" /></view></block><button data-id="{{shot.id}}" bindtap="visualDetails">{{advanced[shot.id] ? '收起视觉细节' : '展开构图、运镜与风格'}}</button><view class="label">不可改变的细节（每行一条）</view><textarea class="input" value="{{shot.constraintsText}}" data-id="{{shot.id}}" data-field="constraints" bindinput="shotInput" maxlength="30000" disabled="{{busy || pending || view || shot.locked}}" /><view class="label">旁白</view><textarea class="input" value="{{shot.voiceover}}" data-id="{{shot.id}}" data-field="voiceover" bindinput="shotInput" maxlength="4000" disabled="{{busy || pending || view || shot.locked}}" /><view class="label">屏幕文字</view><textarea class="input" value="{{shot.screen_text}}" data-id="{{shot.id}}" data-field="screen_text" bindinput="shotInput" maxlength="2000" disabled="{{busy || pending || view || shot.locked}}" /><view class="label">声音 / 音乐位置</view><textarea class="input" value="{{shot.sound_notes}}" data-id="{{shot.id}}" data-field="sound_notes" bindinput="shotInput" maxlength="2000" disabled="{{busy || pending || view || shot.locked}}" /><view class="muted">参考区间：{{shot.reference_span_id || '手工新增'}}</view><view class="row"><button data-id="{{shot.id}}" data-step="-1" bindtap="moveShot" disabled="{{busy || pending || view || position === 0}}">上移</button><button data-id="{{shot.id}}" data-step="1" bindtap="moveShot" disabled="{{busy || pending || view || position + 1 === content.shots.length}}">下移</button><button data-id="{{shot.id}}" bindtap="deleteShot" disabled="{{busy || pending || view || shot.locked || content.shots.length === 1}}">删除</button></view></view>
    <view class="card"><button bindtap="addShot" disabled="{{busy || pending || view}}">添加镜头</button><button class="primary" bindtap="save" disabled="{{busy || pending || view}}">保存新版本</button><button class="primary" bindtap="save" data-confirm="true" disabled="{{busy || pending || view}}">确认分镜内容</button><block wx:if="{{cache.base}}"><button bindtap="openMatching" disabled="{{busy || pending || view}}">匹配素材与补拍</button><button data-id="{{cache.base.document_id}}" bindtap="openStory" disabled="{{busy || pending}}">载入当前版本</button><button data-kind="history" bindtap="more" disabled="{{busy || pending}}">载入版本历史</button></block><button wx:for="{{history}}" wx:key="revision_id" data-id="{{item.revision_id}}" bindtap="historyView" disabled="{{busy || pending}}">查看 v{{item.number}}</button><button wx:if="{{view}}" bindtap="restoreVersion" disabled="{{busy || pending}}">以此历史版本继续修改</button><view class="muted">后续仍需素材匹配、缺口处理、渲染与成片审核。分镜确认不等于交付完成。</view></view>
  </block>
</view>
