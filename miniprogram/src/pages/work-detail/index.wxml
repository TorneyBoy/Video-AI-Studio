<view class="page"><view class="title">审阅与领取</view><view class="intro">播放授权过期后可刷新，无需重新生成。审核绑定这份成片；修改后生成的新成片需重新审核。</view>
  <video id="workPreview" wx:if="{{url}}" src="{{url}}" controls object-fit="contain" style="width:100%;height:650rpx;background:#000" binderror="playbackError" bindtimeupdate="videoTime" />
  <button class="secondary" bindtap="refreshReview" loading="{{reviewLoading || loading}}" disabled="{{reviewLoading || reviewSaving}}">刷新审核与播放</button>
  <view class="card" wx:if="{{report}}"><view class="row"><view class="card-title">{{report.revision_number ? '编辑版本 v' + report.revision_number : '原始清单版本'}} · {{reviewLabel}}</view></view><view class="muted">{{report.quality_scope}}</view><view>{{report.reason}}</view><view class="small" wx:if="{{report.duration !== null}}">{{report.duration}}秒 · {{report.measurements.width}}×{{report.measurements.height}}</view>
    <view wx:if="{{report.latest}}"><view class="label">最近审核意见</view><view class="review-text">{{report.latest.note || '未填写附加意见'}}</view><view class="review-issue review-{{item.severity}}" wx:for="{{report.latest.issues}}" wx:key="index"><view>{{item.message}}</view><button class="small-button" wx:if="{{item.start !== null}}" bindtap="seekIssue" data-start="{{item.start}}" disabled="{{!url}}">定位 {{item.start}} 秒</button></view></view>
    <view class="status" wx:if="{{reviewConflict}}">审核状态已变化，原意见保留；请刷新当前状态后重新审阅。</view><view wx:if="{{pending}}" class="status">审核提交结果尚待核对。原意见和操作标识已保留。<button class="secondary" bindtap="recoverReview" disabled="{{reviewSaving}}">核对原审核提交</button><button class="secondary" bindtap="recoverReview" data-repeat="true" disabled="{{reviewSaving}}">沿用原提交继续</button></view>
    <view wx:if="{{report.can_review}}"><view class="label">本次审核意见</view><textarea class="input review-note" value="{{form.note}}" maxlength="4000" bindinput="reviewNote" placeholder="可填写总体意见；退回时请说明原因" disabled="{{reviewSaving || reviewLoading || pending}}" />
      <view class="review-issue" wx:for="{{form.issues}}" wx:key="index"><view class="label">问题 {{index + 1}}</view><picker range="{{categories}}" value="{{issueIndexes[index].category}}" data-index="{{index}}" data-field="category" bindchange="issueChoice" disabled="{{reviewSaving || pending}}"><view class="input">{{categories[issueIndexes[index].category]}}</view></picker><picker range="{{severities}}" value="{{issueIndexes[index].severity}}" data-index="{{index}}" data-field="severity" bindchange="issueChoice" disabled="{{reviewSaving || pending}}"><view class="input">{{severities[issueIndexes[index].severity]}}</view></picker><textarea class="input review-note" value="{{item.message}}" maxlength="2000" data-index="{{index}}" data-field="message" bindinput="issueInput" placeholder="问题说明" disabled="{{reviewSaving || pending}}"/><input class="input" value="{{item.start}}" data-index="{{index}}" data-field="start" bindinput="issueInput" placeholder="起点秒数（可留空）" disabled="{{reviewSaving || pending}}"/><input class="input" value="{{item.end}}" data-index="{{index}}" data-field="end" bindinput="issueInput" placeholder="终点秒数（可留空）" disabled="{{reviewSaving || pending}}"/><button class="small-button" bindtap="removeIssue" data-index="{{index}}" disabled="{{reviewSaving || pending}}">移除此条</button></view>
      <button class="secondary" bindtap="addIssue" disabled="{{reviewSaving || pending || form.issues.length &gt;= 50}}">添加问题（可标记当前播放时间）</button><button class="primary" bindtap="submitReview" data-decision="approved" disabled="{{reviewSaving || reviewLoading || reviewConflict || pending || !report.quality_ready}}">批准这份成片</button><button class="secondary" bindtap="submitReview" data-decision="changes_requested" disabled="{{reviewSaving || reviewLoading || reviewConflict || pending}}">退回修改</button><button class="secondary" bindtap="discardReviewDraft" disabled="{{reviewSaving || pending}}">放弃未保存意见</button>
    </view><view wx:else class="muted">当前仅空间所有者可审核；可查看审核意见。</view>
    <button class="secondary" wx:if="{{report.origin_job_id}}" bindtap="continueEditing">继续编辑当前计划</button><button class="secondary" bindtap="history" wx:if="{{!showHistory || historyMore}}">{{showHistory ? '加载更早审核记录' : '查看审核历史'}}</button><view wx:if="{{showHistory}}"><view class="review-issue" wx:for="{{history}}" wx:key="id"><view>#{{item.number}} · {{item.label}} · {{item.created_at}}</view><view class="review-text">{{item.note}}</view><view class="small" wx:for="{{item.issues}}" wx:for-item="issue" wx:key="index">{{issue.message}}</view></view><view class="muted" wx:if="{{!history.length}}">尚无审核记录</view></view>
  </view>
  <button class="primary" bindtap="saveVideo" loading="{{saving}}" disabled="{{saving || reviewSaving || pending || !report.can_download}}">保存到相册</button><button class="secondary" bindtap="openDelivery" wx:if="{{report}}">交付文件与分享</button><button class="secondary" bindtap="compareVersions" wx:if="{{report.project_id}}">比较另一版本</button><view class="status">{{status}}</view>
</view>
