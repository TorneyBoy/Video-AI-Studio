<view class="page"><view class="eyebrow">AI PRODUCTION</view><view class="title">补镜头与换人物</view><view class="intro">先核对报价，再确认制作。完成后采用为项目素材，继续分镜匹配与剪辑。</view><view class="status">{{status}}</view>
 <view class="card" wx:if="{{cache.pending}}"><view class="card-title">结果待确认：{{pendingLabel}}</view><view class="muted">已保存原键与正文。查询与重放继续原请求。</view><button class="secondary" bindtap="recover" disabled="{{busy}}">查询原结果</button><button class="secondary" data-replay="true" bindtap="recover" disabled="{{busy}}">重放原请求</button></view>
 <view class="card" wx:if="{{cache}}"><view class="label">制作方式</view><picker range="{{operations}}" range-key="label" value="{{operationIndex}}" bindchange="operation" disabled="{{busy || cache.pending}}"><view class="input">{{operations[operationIndex].label}}</view></picker><view class="label">模型</view><picker range="{{modelOptions}}" value="{{modelIndex}}" bindchange="model" disabled="{{busy || cache.pending || !models.length}}"><view class="input">{{modelOptions[modelIndex] || '暂无对应模型'}}</view></picker><view class="muted">{{modelReason}}</view><view class="label">制作场景</view><picker range="{{scenarioOptions}}" value="{{scenarioIndex}}" bindchange="scenario" disabled="{{busy || cache.pending}}"><view class="input">{{scenarioOptions[scenarioIndex]}}</view></picker><view class="muted">{{scenarioReason}}</view><block wx:if="{{cache.draft.operation === 'video_generation'}}"><view class="label">镜头描述</view><textarea class="input ai-textarea" value="{{cache.draft.prompt}}" data-field="prompt" bindinput="field" maxlength="{{promptLimit}}" disabled="{{busy || cache.pending}}" /></block><view class="muted" wx:else>按原视频动作替换为目标人物；当前入口不向替换模型发送文字生成要求。</view><block wx:if="{{cache.draft.operation === 'video_generation'}}"><view class="label">生成时长（秒）</view><picker wx:if="{{allowedDurations.length}}" range="{{allowedDurations}}" value="{{durationIndex}}" bindchange="durationPick" disabled="{{busy || cache.pending}}"><view class="input">{{allowedDurations[durationIndex]}} 秒</view></picker><input wx:else class="input" type="digit" value="{{cache.draft.duration_seconds}}" data-field="duration_seconds" bindinput="field" disabled="{{busy || cache.pending}}" /><block wx:if="{{resolutions.length}}"><view class="label">生成分辨率</view><picker range="{{resolutions}}" value="{{resolutionIndex}}" bindchange="resolutionPick" disabled="{{busy || cache.pending}}"><view class="input">{{resolutions[resolutionIndex]}}</view></picker></block></block><view class="muted" wx:else>原视频时长：{{sourceDuration}} 秒。换人物保留原视频时长。</view><block wx:if="{{cache.draft.operation !== 'video_generation' &amp;&amp; modes.length}}"><view class="label">人物替换模式</view><picker range="{{modes}}" value="{{modeIndex}}" bindchange="modePick" disabled="{{busy || cache.pending}}"><view class="input">{{modes[modeIndex]}}</view></picker></block>
 <view wx:for="{{parameterFields}}" wx:key="name"><view class="label">{{item.label}}{{item.required ? '（必填）' : ''}}</view><picker wx:if="{{item.kind === 'select'}}" range="{{item.options}}" value="{{item.index}}" data-name="{{item.name}}" bindchange="parameterPick" disabled="{{busy || cache.pending}}"><view class="input">{{item.options[item.index]}}</view></picker><input wx:else class="input" type="text" value="{{item.value}}" data-name="{{item.name}}" bindinput="parameter" maxlength="{{item.maxLength}}" placeholder="使用模型默认值" disabled="{{busy || cache.pending}}" /></view>
 <block wx:if="{{cache.draft.operation === 'video_generation'}}"><view class="label">参考图片（按模型要求）</view><view class="muted" wx:if="{{maxReferences === 0}}">当前模型仅使用文字描述，不接受图片参考。</view><block wx:else><button class="secondary" wx:for="{{references}}" wx:key="id" data-id="{{item.id}}" bindtap="reference" disabled="{{busy || cache.pending}}">{{item.selected ? '✓ ' : '○ '}}{{item.name}}</button><view class="muted" wx:if="{{!references.length}}">暂无可用参考图片</view></block><view wx:if="{{cache.draft.storyboard}}"><view class="pill">已绑定分镜 {{cache.draft.storyboard.shot_id}}</view><view class="small muted">版本 {{cache.draft.storyboard.revision_id}}</view><button class="secondary" bindtap="unbind" disabled="{{busy || cache.pending}}">解除分镜绑定</button></view></block>
 <block wx:else><view class="label">待替换的原始视频</view><picker range="{{videoOptions}}" value="{{videoIndex}}" bindchange="source" disabled="{{busy || cache.pending}}"><view class="input">{{videoOptions[videoIndex]}}</view></picker><view class="label">已授权目标人物档案</view><picker range="{{profileOptions}}" value="{{profileIndex}}" bindchange="profile" disabled="{{busy || cache.pending}}"><view class="input">{{profileOptions[profileIndex]}}</view></picker><view class="muted">{{profiles.length ? '服务端将在报价和提交时核验人物授权范围、状态与有效期。' : '当前项目没有人物档案，可在下方选择参考图片并明确授权后创建。'}}</view><view class="divider"></view><view class="card-title">创建已授权人物档案</view><view class="muted">主体由你填写，不进行人脸身份识别。此授权允许在当前项目中将参考图片用于换脸和换人物，并由已配置的托管服务处理。</view><input class="input" value="{{profileDraft.name}}" data-field="name" bindinput="profileField" maxlength="200" placeholder="档案名称" disabled="{{busy || cache.pending}}" /><input class="input" value="{{profileDraft.subject_id}}" data-field="subject_id" bindinput="profileField" maxlength="200" placeholder="获得授权的目标人物姓名或主体编号" disabled="{{busy || cache.pending}}" /><picker range="{{imageOptions}}" value="{{imageIndex}}" bindchange="profileImage" disabled="{{busy || cache.pending}}"><view class="input">人物参考图片：{{imageOptions[imageIndex]}}</view></picker><checkbox-group bindchange="profileGrant"><label class="ai-consent"><checkbox value="granted" checked="{{profileDraft.granted}}" disabled="{{busy || cache.pending}}" />我已取得此人物用于上述用途的明确授权</label></checkbox-group><button class="secondary" bindtap="createProfile" disabled="{{busy || cache.pending}}">创建授权人物档案</button></block>
 <button class="primary" bindtap="requestQuote" disabled="{{busy || cache.pending || !canQuote}}">获取制作报价</button></view>
 <view class="card" wx:if="{{quote}}"><view class="card-title">确认制作报价</view><view>{{quoteSummary}}</view><view class="small muted">{{quoteSelection}}</view><view class="label">{{quoteAmount}}</view><view class="small muted">有效至 {{quote.expires_at}}</view><view class="status" wx:for="{{quote.reasons}}" wx:key="*this">{{item}}</view><button class="primary" bindtap="submit" disabled="{{busy || cache.pending || !quoteReady}}">确认费用并开始制作</button></view>
 <view class="row"><button class="secondary" bindtap="load" disabled="{{busy}}">刷新任务</button><button class="secondary" bindtap="billing">费用与任务恢复</button></view><view class="label">本项目AI制作任务</view><view class="muted" wx:if="{{!jobs.length}}">还没有AI制作任务</view><view class="card" wx:for="{{jobs}}" wx:key="id"><view class="row"><view class="card-title">{{item.label}}</view><view class="pill">{{item.statusLabel}}</view></view><view>{{item.prompt}}</view><view class="small muted">{{item.selectionLabel}}</view><view class="status" wx:if="{{item.failure_code}}">{{item.failure_code}} · 请在费用与任务恢复中核对可用操作。</view><view class="small muted" wx:if="{{item.storyboard}}">关联分镜 {{item.storyboard.shot_id}}</view><block wx:if="{{item.adopted_asset_id}}"><view class="label">已采用为项目素材</view><button class="secondary" data-id="{{item.adopted_asset_id}}" bindtap="preview">预览素材</button></block><button wx:elif="{{item.can_adopt}}" class="primary" data-id="{{item.id}}" bindtap="adopt" disabled="{{busy || cache.pending}}">采用为项目素材</button></view><video class="ai-preview" wx:if="{{playerUrl}}" src="{{playerUrl}}" controls /><button class="secondary" bindtap="assets">回到项目素材库</button>
</view>
