.section-title{font-size:34rpx;font-weight:600;margin:36rpx 0 12rpx}.small-button{font-size:23rpx;line-height:1.6;padding:12rpx 18rpx;background:#30263f;color:#daccf8;border-radius:12rpx;margin:0}.actions{display:flex;flex-wrap:wrap;gap:14rpx;margin:20rpx 0}.candidate{border-top:1rpx solid #393142;padding:22rpx 0;display:flex;flex-direction:column;gap:14rpx}.locked{border-color:#a88be5}.draft{border-color:#a18452}.warning{color:#d9bf85;font-size:24rpx;line-height:1.7;margin-top:18rpx}.shot .small{line-height:1.8;margin-top:12rpx}
.clip-strip{width:100%;white-space:nowrap}.clip-strip-inner{display:flex;gap:12rpx;padding:12rpx 0}.clip-segment{flex-shrink:0;width:300rpx;text-align:left;line-height:1.7;font-size:24rpx;white-space:normal;margin:0;padding:20rpx;border:1rpx solid #6f5689;border-radius:14rpx;background:#2b2237;color:#eadcf8}.clip-segment.selected{border-color:#c4a0f4;background:#3c2c50}.precise{border-color:#8e6bad}.precise .label{margin-top:20rpx}
.subtitle-cue{border-top:1rpx solid #4b3c5b;padding:24rpx 0}.subtitle-text{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.8}.subtitle-textarea{width:auto;min-height:180rpx}.subtitle-preview{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.7;padding:24rpx;background:#4b4058;border-radius:14rpx;margin:24rpx 0}
